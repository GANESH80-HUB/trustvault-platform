# Application Configuration
PORT=3000
NODE_ENV=development

# Session Security (Generate a strong 32+ character random string for production)
SESSION_SECRET=trustvault-dev-session-secret-change-me-in-production-min32chars

# Persistent Data Storage Configuration
# For local development, this defaults to ./data
# On Render with a Persistent Disk, set this to your disk mount path (e.g. /var/data)
DATA_DIR=./data

# Maximum file upload size in megabytes (Default: 20MB)
MAX_FILE_SIZE_MB=20
